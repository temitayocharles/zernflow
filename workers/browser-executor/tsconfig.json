{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": "../..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "../../lib/browser/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "../../lib/browser/**/*.test.ts", "../../lib/browser/fake-surface.ts", "dist", "node_modules"]
}
