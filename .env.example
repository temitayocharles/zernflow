# Supabase
# Self-hosted runtime aliases. These are preferred by server-side ZernFlow code
# so values are not frozen into the Next.js bundle during `next build`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Public-prefixed names remain for local/build compatibility and client tooling.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Keep false until a GitHub OAuth provider is configured in the ZernFlow Supabase project.
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false

# Agent Social Gateway
# These values are server-only. Never prefix them with NEXT_PUBLIC_ or persist them
# in workspace/channel rows. Leave them unset only while running the UI without
# provider connectivity during local development or migration.
SOCIAL_GATEWAY_BASE_URL=https://gateway.example.com
SOCIAL_GATEWAY_API_KEY=replace-with-operator-api-key-at-least-24-characters
# Required only for approvals, rejection and human-takeover administration.
SOCIAL_GATEWAY_ADMIN_API_KEY=replace-with-admin-api-key-at-least-24-characters
# Required only when this ZernFlow runtime submits work as a dedicated agent.
# SOCIAL_GATEWAY_AGENT_CREDENTIAL=replace-with-issued-agent-credential
SOCIAL_GATEWAY_ACTOR_REF=zernflow
SOCIAL_GATEWAY_WORKSPACE_REF=default
# The single ZernFlow workspace allowed to project this deployment's Gateway
# accounts (channel sync/connect, conversation sync, inbound webhooks). If
# unset, the gateway_workspace_bindings table is used (migration 00030
# backfills it when exactly one workspace already has channels). Unbound or
# conflicting configuration fails closed.
# SOCIAL_GATEWAY_BOUND_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
SOCIAL_GATEWAY_TIMEOUT_MS=10000
# Shared HMAC secret used only to verify signed event deliveries from the
# gateway. Store the same value in Vault at the endpoint's secret_ref.
SOCIAL_GATEWAY_WEBHOOK_SECRET=replace-with-random-webhook-secret-at-least-24-characters

# Legacy hosted-Zernio migration mode
# Disabled by default. Enable only in a bounded migration environment while a
# remaining legacy route is being replaced, then disable it again.
ENABLE_LEGACY_ZERNIO=false
# Legacy Zernio webhook (/api/webhooks/late) brownout before stage-2 removal:
# "reject" answers 410 Gone without processing. Unset (default) = accept.
# LEGACY_ZERNIO_WEBHOOK=reject

# Optional link to the canonical source repository, shown on the landing page.
# NEXT_PUBLIC_SOURCE_URL=https://forgejo.example/owner/zernflow

# AI Gateway (server-only fallback for AI Response flow nodes)
# Configure provider keys in your approved secret manager or AI Gateway.
# AI_GATEWAY_API_KEY=replace-with-ai-gateway-key

# Cron secret (for sequence processor and job scheduler). At least 24
# characters; accepted only as `Authorization: Bearer <secret>` (or the
# x-cron-secret header). The legacy ?key= query parameter is refused.
CRON_SECRET=replace-with-random-cron-secret-at-least-24-characters

# Outbound HTTP from flow HTTP nodes is SSRF-guarded: private, loopback,
# link-local/metadata and reserved addresses are refused and redirects are not
# followed. Self-hosted operators may allow exact internal hostnames here.
# SAFE_FETCH_ALLOW_HOSTS=n8n.internal.example

# Zero-cost runtime safeguards (queues wait instead of scaling; never set
# PAID_COMPUTE_ALLOWED=true unless an operator explicitly accepts spend).
PAID_COMPUTE_ALLOWED=false
MAX_BACKGROUND_WORKERS=1
MAX_TASKS_PER_TICK=10
TICK_TIME_BUDGET_MS=25000
MAX_BROWSER_CONCURRENCY=1
BROWSER_IDLE_SHUTDOWN=true
# Lead intake requests per token per minute (in-process limiter; single-instance deployment).
LEAD_INTAKE_RATE_PER_MINUTE=60
# Hours between scheduled read-only browser-session checks (0 disables scheduled checks).
BROWSER_SESSION_CHECK_HOURS=24
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_ARTIFACT_RETENTION_DAYS=30

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

SOCIAL_GATEWAY_AGENT_ID=

# Provider onboarding is enabled dynamically only when the Gateway reports that
# its Meta app, webhook verification and Vault writer are fully configured.

# Optional external knowledge retrieval seam. Complete server-side HTTPS endpoint;
# no invented Gateway path is appended. Contract: docs/PRODUCT_INTEGRATION_SEAMS.md.
KNOWLEDGE_RETRIEVAL_URL=
KNOWLEDGE_API_TOKEN=

# --- Secret store (R3) -------------------------------------------------------
# Production: Vault Transit wraps per-secret data keys; the root key never
# leaves Vault. Token policy needs only encrypt/decrypt on the transit key.
SECRET_STORE_KEK_PROVIDER=vault-transit
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=zernflow-secrets
# VAULT_NAMESPACE=
# Development / single-node self-hosting only (32 random bytes, base64):
#   openssl rand -base64 32
# Refused when NODE_ENV=production unless ZERNFLOW_ALLOW_LOCAL_KEK=true.
# ZERNFLOW_LOCAL_KEK=
# ZERNFLOW_LOCAL_KEK_ID=local:default
# ZERNFLOW_ALLOW_LOCAL_KEK=false
# Local KEK rotation only (see docs/architecture/SECRET_STORE_DESIGN.md §5.1):
# keep the retired key here until the `secrets.rewrap` task reports failed=0.
# ZERNFLOW_LOCAL_KEK_PREVIOUS=
# ZERNFLOW_LOCAL_KEK_PREVIOUS_ID=

# --- Artifact storage (R5) — any S3-compatible provider ----------------------
# Private bucket. Free options: a free-tier S3-compatible bucket, or MinIO /
# Garage on your own K3s. Bucket CORS must allow PUT from NEXT_PUBLIC_APP_URL
# with headers content-type, x-amz-checksum-sha256, x-amz-server-side-encryption.
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_REGION=auto
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_FORCE_PATH_STYLE=false
# AES256 | aws:kms | none (use none for providers that always encrypt at rest and reject the header)
ARTIFACT_S3_SSE=AES256
# sha256 | none (none only if the provider rejects x-amz-checksum-sha256)
ARTIFACT_S3_CHECKSUM=sha256
# Per-workspace storage cap (keeps usage inside free tiers). Default 5 GiB.
MAX_WORKSPACE_STORAGE_BYTES=5368709120

# --- Browser executor job (workers/browser-executor; Northflank Job 1, NOT Service 1) ---
# ZERNFLOW_URL=https://your-zernflow-host
# ZERNFLOW_WORKER_TOKEN=zfw_...          # issued under Jobs -> Workers with mode "browser"
# BROWSER_JOB_MAX_MS=600000              # the job exits after this even if work remains
# BROWSER_CHECK_TIMEOUT_MS=90000
# BROWSER_NAVIGATION_TIMEOUT_MS=30000
# BROWSER_IDLE_SHUTDOWN=true             # exit as soon as the queue is empty
