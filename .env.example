# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Self-hosted social gateway. Inject secrets from Vault/External Secrets.
SOCIAL_GATEWAY_DRIVER=agent
SOCIAL_GATEWAY_BASE_URL=http://agent-social-gateway.social-platform.svc.cluster.local:8080
SOCIAL_GATEWAY_API_KEY=replace-with-vault-injected-value
SOCIAL_GATEWAY_WEBHOOK_SECRET=replace-with-vault-injected-value

# Temporary hosted compatibility mode only:
# SOCIAL_GATEWAY_DRIVER=zernio
# ZERNIO_API_KEY=replace-with-vault-injected-value

# AI runtime, optional. Inject from Vault; never store it in Supabase.
# AI_GATEWAY_API_KEY=replace-with-vault-injected-value

# Cron secret
CRON_SECRET=replace-with-vault-injected-value

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
